# Check and install required packages
required_packages <- c("shiny", "shinythemes", "ggplot2", "dplyr", "DT", "rmarkdown")
new_packages <- required_packages[!(required_packages %in% installed.packages()[,"Package"])]
if(length(new_packages)) {
install.packages(new_packages, repos = "https://cran.r-project.org")
}
# Load libraries
library(shiny)
library(shinythemes)
library(ggplot2)
library(dplyr)
library(DT)
library(rmarkdown)
# Simulated Kenyan actuarial dataset with counties, wards, and fraud detection
generate_data <- function(n = 1000) {
tryCatch({
set.seed(123)
# List of all 47 Kenyan counties
counties <- c("Baringo", "Bomet", "Bungoma", "Busia", "Elgeyo-Marakwet", "Embu", "Garissa",
"Homa Bay", "Isiolo", "Kajiado", "Kakamega", "Kericho", "Kiambu", "Kilifi",
"Kirinyaga", "Kisii", "Kisumu", "Kitui", "Kwale", "Laikipia", "Lamu", "Machakos",
"Makueni", "Mandera", "Marsabit", "Meru", "Migori", "Mombasa", "Murang'a",
"Nairobi", "Nakuru", "Nandi", "Narok", "Nyamira", "Nyandarua", "Nyeri",
"Samburu", "Siaya", "Taita-Taveta", "Tana River", "Tharaka-Nithi", "Trans Nzoia",
"Turkana", "Uasin Gishu", "Vihiga", "Wajir", "West Pokot")
# Sample ward lists for select counties
ward_lists <- list(
Nairobi = c("Kilimani", "Dagoretti", "Langata", "Kibera", "Mathare", "Embakasi", "Kasarani",
"Roysambu", "Ruaraka", "Westlands", "Makadara", "Kamukunji", "Starehe",
"Njiru", "Dandora", "Kayole", "Umoja"), # Subset of 85 wards
Kiambu = c("Thika Township", "Ruiru", "Githunguri", "Kiambaa", "Limuru Central",
"Gatundu", "Juja", "Kabete"), # Subset of 60 wards
"Murang'a" = c("Township", "Kangari", "Kiharu", "Gatanga", "Kandara"), # Subset of 35
Nyeri = c("Rware", "Karatina Town", "Mukurwe-ini", "Konyu", "Mahiga"), # Subset of 30
Samburu = c("Maralal", "Waso", "Ndoto", "Poro", "Suguta Marmar"), # Subset of 15
Wajir = c("Wajir East", "Tarbaj", "Eldas", "Benane", "Korondille") # Subset of 30
)
# Generate wards for other counties
for (county in counties[!counties %in% names(ward_lists)]) {
ward_lists[[county]] <- paste(county, "Ward", 1:5, sep = "_")
}
# Generate dataset
data <- data.frame(
PolicyID = 1:n,
Age = sample(18:80, n, replace = TRUE),
Region = sample(counties, n, replace = TRUE),
Premium = runif(n, 5000, 50000),
ClaimAmount = rlnorm(n, meanlog = 8, sdlog = 1),
RiskScore = runif(n, 0, 100),
BigDataUsage = sample(c("High", "Medium", "Low", "None"), n, replace = TRUE)
)
# Assign wards based on region
data$Ward <- sapply(data$Region, function(region) {
sample(ward_lists[[region]], 1)
})
# Validate data
if (any(is.na(data))) stop("Generated data contains NA values")
return(data)
}, error = function(e) {
message("Error in data generation: ", e$message)
# Fallback dataset
data.frame(
PolicyID = 1:10,
Age = rep(30, 10),
Region = rep("Nairobi", 10),
Ward = rep("Kilimani", 10),
Premium = rep(10000, 10),
ClaimAmount = rep(5000, 10),
RiskScore = rep(50, 10),
BigDataUsage = rep("Medium", 10)
)
})
}
# Initial data
actuarial_data <- generate_data()
# Ward lists for dynamic UI
ward_lists <- list(
Nairobi = c("Kilimani", "Dagoretti", "Langata", "Kibera", "Mathare", "Embakasi", "Kasarani",
"Roysambu", "Ruaraka", "Westlands", "Makadara", "Kamukunji", "Starehe",
"Njiru", "Dandora", "Kayole", "Umoja"),
Kiambu = c("Thika Township", "Ruiru", "Githunguri", "Kiambaa", "Limuru Central",
"Gatundu", "Juja", "Kabete"),
"Murang'a" = c("Township", "Kangari", "Kiharu", "Gatanga", "Kandara"),
Nyeri = c("Rware", "Karatina Town", "Mukurwe-ini", "Konyu", "Mahiga"),
Samburu = c("Maralal", "Waso", "Ndoto", "Poro", "Suguta Marmar"),
Wajir = c("Wajir East", "Tarbaj", "Eldas", "Benane", "Korondille")
)
counties <- unique(actuarial_data$Region)
for (county in counties[!counties %in% names(ward_lists)]) {
ward_lists[[county]] <- paste(county, "Ward", 1:5, sep = "_")
}
# UI
ui <- fluidPage(
theme = shinytheme("cerulean"),
titlePanel("Big Data in Actuarial Risk Management: Kenya"),
sidebarLayout(
sidebarPanel(
h4("Data Input"),
numericInput("input_age", "Age:", value = 30, min = 18, max = 80),
selectInput("input_region", "County:", choices = counties),
selectInput("input_ward", "Ward:", choices = c("Kilimani")),
numericInput("input_premium", "Premium (KES):", value = 10000, min = 0),
numericInput("input_claim", "Claim Amount (KES):", value = 5000, min = 0),
numericInput("input_risk", "Risk Score:", value = 50, min = 0, max = 100),
selectInput("input_bigdata", "Big Data Usage:", choices = c("High", "Medium", "Low", "None")),
actionButton("add_data", "Add Policy"),
fileInput("upload_data", "Upload CSV:", accept = ".csv"),
downloadButton("download_template", "Download CSV Template"),
hr(),
h4("Filter Data"),
sliderInput("age_range", "Age Range:", min = 18, max = 80, value = c(18, 80)),
selectInput("region", "County:", choices = c("All", counties), selected = "All"),
selectInput("ward", "Ward:", choices = c("All"), selected = "All"),
selectInput("bigdata_usage", "Big Data Usage:", choices = c("All", unique(actuarial_data$BigDataUsage)), selected = "All"),
selectInput("fraud_flag", "Fraud Status:", choices = c("All", "Suspected", "None"), selected = "All"),
downloadButton("download_report", "Download HTML Report")
),
mainPanel(
tabsetPanel(
tabPanel("Opportunities",
h3("Opportunities in Big Data"),
p("Big data enhances actuarial risk management in Kenya through:"),
tags$ul(
tags$li("Precise risk modeling with mobile and IoT data."),
tags$li("Personalized insurance products via customer segmentation."),
tags$li("Fraud detection using predictive analytics.")
),
plotOutput("opportunity_plot")
),
tabPanel("Challenges",
h3("Challenges in Big Data Adoption"),
p("Key challenges in Kenya include:"),
tags$ul(
tags$li("High costs and limited data infrastructure."),
tags$li("Compliance with Data Protection Act regulations."),
tags$li("False positives in fraud detection models.")
),
plotOutput("challenge_plot")
),
tabPanel("Fraud Detection",
h3("Fraud Detection Insights"),
p("Big data identifies potential fraudulent claims at ward level. Suspected cases are flagged based on high claim amounts or unusual risk scores."),
verbatimTextOutput("fraud_summary"),
plotOutput("fraud_plot")
),
tabPanel("Data Explorer",
h3("Explore Actuarial Data"),
DTOutput("data_table")
)
)
)
)
)
# Server
server <- function(input, output, session) {
# Reactive value to store data
rv <- reactiveValues(data = actuarial_data)
# Update ward choices for input
observe({
selected_region <- input$input_region
updateSelectInput(session, "input_ward", choices = ward_lists[[selected_region]])
})
# Update ward choices for filter
observe({
selected_region <- input$region
if (selected_region == "All") {
ward_choices <- c("All")
} else {
ward_choices <- c("All", unique(rv$data$Ward[rv$data$Region == selected_region]))
}
updateSelectInput(session, "ward", choices = ward_choices, selected = "All")
})
# Add manual data input
observeEvent(input$add_data, {
tryCatch({
# Validate inputs
if (!is.numeric(input$input_age) || input$input_age < 18 || input$input_age > 80) {
showNotification("Age must be between 18 and 80.", type = "error")
return()
}
if (!input$input_region %in% counties) {
showNotification("Invalid county.", type = "error")
return()
}
if (!input$input_ward %in% ward_lists[[input$input_region]]) {
showNotification("Invalid ward for selected county.", type = "error")
return()
}
if (!is.numeric(input$input_premium) || input$input_premium < 0) {
showNotification("Premium must be non-negative.", type = "error")
return()
}
if (!is.numeric(input$input_claim) || input$input_claim < 0) {
showNotification("Claim Amount must be non-negative.", type = "error")
return()
}
if (!is.numeric(input$input_risk) || input$input_risk < 0 || input$input_risk > 100) {
showNotification("Risk Score must be between 0 and 100.", type = "error")
return()
}
if (!input$input_bigdata %in% c("High", "Medium", "Low", "None")) {
showNotification("Invalid Big Data Usage.", type = "error")
return()
}
# Create new policy
new_policy <- data.frame(
PolicyID = max(rv$data$PolicyID) + 1,
Age = input$input_age,
Region = input$input_region,
Ward = input$input_ward,
Premium = input$input_premium,
ClaimAmount = input$input_claim,
RiskScore = input$input_risk,
BigDataUsage = input$input_bigdata,
FraudFlag = "None" # Temporary
)
# Append and flag fraud
rv$data <- rbind(rv$data, new_policy)
claim_threshold <- quantile(rv$data$ClaimAmount, 0.9)
rv$data$FraudFlag <- ifelse(rv$data$ClaimAmount > claim_threshold | rv$data$RiskScore > 95, "Suspected", "None")
showNotification("Policy added successfully.", type = "message")
}, error = function(e) {
showNotification(paste("Error adding policy:", e$message), type = "error")
})
})
# Handle CSV upload
observeEvent(input$upload_data, {
tryCatch({
file <- input$upload_data
ext <- tools::file_ext(file$datapath)
if (ext != "csv") {
showNotification("Please upload a CSV file.", type = "error")
return()
}
uploaded_data <- read.csv(file$datapath, stringsAsFactors = FALSE)
expected_cols <- c("PolicyID", "Age", "Region", "Ward", "Premium", "ClaimAmount", "RiskScore", "BigDataUsage")
if (!all(expected_cols %in% colnames(uploaded_data))) {
showNotification("CSV must contain columns: PolicyID, Age, Region, Ward, Premium, ClaimAmount, RiskScore, BigDataUsage.", type = "error")
return()
}
# Validate data
if (any(!is.numeric(uploaded_data$Age) | uploaded_data$Age < 18 | uploaded_data$Age > 80)) {
showNotification("Age must be numeric between 18 and 80.", type = "error")
return()
}
if (any(!uploaded_data$Region %in% counties)) {
showNotification("All Regions must be valid Kenyan counties.", type = "error")
return()
}
if (any(!mapply(function(r, w) w %in% ward_lists[[r]], uploaded_data$Region, uploaded_data$Ward))) {
showNotification("All Wards must be valid for their respective counties.", type = "error")
return()
}
if (any(!is.numeric(uploaded_data$Premium) | uploaded_data$Premium < 0)) {
showNotification("Premium must be non-negative numeric.", type = "error")
return()
}
if (any(!is.numeric(uploaded_data$ClaimAmount) | uploaded_data$ClaimAmount < 0)) {
showNotification("Claim Amount must be non-negative numeric.", type = "error")
return()
}
if (any(!is.numeric(uploaded_data$RiskScore) | uploaded_data$RiskScore < 0 | uploaded_data$RiskScore > 100)) {
showNotification("Risk Score must be numeric between 0 and 100.", type = "error")
return()
}
if (any(!uploaded_data$BigDataUsage %in% c("High", "Medium", "Low", "None"))) {
showNotification("Big Data Usage must be High, Medium, Low, or None.", type = "error")
return()
}
# Append and flag fraud
uploaded_data$FraudFlag <- "None" # Temporary
rv$data <- rbind(rv$data, uploaded_data)
claim_threshold <- quantile(rv$data$ClaimAmount, 0.9)
rv$data$FraudFlag <- ifelse(rv$data$ClaimAmount > claim_threshold | rv$data$RiskScore > 95, "Suspected", "None")
showNotification("CSV data uploaded successfully.", type = "message")
}, error = function(e) {
showNotification(paste("Error uploading CSV:", e$message), type = "error")
})
})
# Download CSV template
output$download_template <- downloadHandler(
filename = "policy_template.csv",
content = function(file) {
template <- data.frame(
PolicyID = 1,
Age = 30,
Region = "Nairobi",
Ward = "Kilimani",
Premium = 10000,
ClaimAmount = 5000,
RiskScore = 50,
BigDataUsage = "Medium"
)
write.csv(template, file, row.names = FALSE)
}
)
# Reactive filtered data
filtered_data <- reactive({
tryCatch({
data <- rv$data
data <- data %>% filter(Age >= input$age_range[1], Age <= input$age_range[2])
if (input$region != "All") {
data <- data %>% filter(Region == input$region)
}
if (input$ward != "All") {
data <- data %>% filter(Ward == input$ward)
}
if (input$bigdata_usage != "All") {
data <- data %>% filter(BigDataUsage == input$bigdata_usage)
}
if (input$fraud_flag != "All") {
data <- data %>% filter(FraudFlag == input$fraud_flag)
}
if (nrow(data) == 0) {
showNotification("No data matches the selected filters.", type = "warning")
return(rv$data[1:10, ]) # Fallback
}
return(data)
}, error = function(e) {
showNotification(paste("Error in filtering data:", e$message), type = "error")
return(rv$data[1:10, ]) # Fallback
})
})
# Opportunity plot
output$opportunity_plot <- renderPlot({
tryCatch({
ggplot(filtered_data(), aes(x = RiskScore, y = Premium, color = BigDataUsage)) +
geom_point(alpha = 0.6) +
labs(title = "Premium vs Risk Score by Big Data Usage",
x = "Risk Score", y = "Premium (KES)") +
theme_minimal()
}, error = function(e) {
showNotification("Error rendering opportunity plot.", type = "error")
ggplot() + geom_text(aes(x = 0, y = 0, label = "Plot unavailable")) + theme_minimal()
})
})
# Challenge plot
output$challenge_plot <- renderPlot({
tryCatch({
ggplot(filtered_data(), aes(x = ClaimAmount, fill = Region)) +
geom_histogram(bins = 30, alpha = 0.7) +
labs(title = "Claim Amount Distribution by County",
x = "Claim Amount (KES)", y = "Count") +
theme_minimal() +
scale_x_log10()
}, error = function(e) {
showNotification("Error rendering challenge plot.", type = "error")
ggplot() + geom_text(aes(x = 0, y = 0, label = "Plot unavailable")) + theme_minimal()
})
})
# Fraud plot
output$fraud_plot <- renderPlot({
tryCatch({
ggplot(filtered_data(), aes(x = RiskScore, y = ClaimAmount, color = FraudFlag)) +
geom_point(alpha = 0.6) +
scale_y_log10() +
labs(title = "Fraud Detection: Claim Amount vs Risk Score",
x = "Risk Score", y = "Claim Amount (KES)") +
theme_minimal() +
scale_color_manual(values = c("None" = "blue", "Suspected" = "red"))
}, error = function(e) {
showNotification("Error rendering fraud plot.", type = "error")
ggplot() + geom_text(aes(x = 0, y = 0, label = "Plot unavailable")) + theme_minimal()
})
})
# Fraud summary
output$fraud_summary <- renderText({
tryCatch({
fraud_count <- sum(filtered_data()$FraudFlag == "Suspected")
total_count <- nrow(filtered_data())
fraud_pct <- round(fraud_count / total_count * 100, 2)
paste("Fraud Analysis:\n",
fraud_count, "out of", total_count, "claims are flagged as suspected fraud (",
fraud_pct, "%).\n",
"Suspected claims have high claim amounts or extreme risk scores, often in specific wards.")
}, error = function(e) {
showNotification("Error generating fraud summary.", type = "error")
"Fraud summary unavailable."
})
})
# Data table
output$data_table <- renderDT({
tryCatch({
datatable(filtered_data(), options = list(pageLength = 10, scrollX = TRUE))
}, error = function(e) {
showNotification("Error rendering data table.", type = "error")
datatable(data.frame(Error = "Table unavailable"), options = list(pageLength = 1))
})
})
